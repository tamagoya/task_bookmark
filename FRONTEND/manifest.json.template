{
  "manifest_version": 3,
  "name": "タスクブックマーク",
  "version": "0.1.0",
  "description": "ブラウザの作業状態をGoogle Calendarに保存・復元するChrome拡張機能",
  "permissions": [
    "identity",
    "storage",
    "tabs",
    "windows",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/task_bookmark_icon.png",
    "32": "icons/task_bookmark_icon.png",
    "48": "icons/task_bookmark_icon.png",
    "128": "icons/task_bookmark_icon.png"
  },
  "action": {
    "default_title": "タスクブックマーク",
    "default_icon": {
      "16": "icons/task_bookmark_icon.png",
      "32": "icons/task_bookmark_icon.png",
      "48": "icons/task_bookmark_icon.png"
    }
  },
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content-scripts/calendar-restore-button.js"]
    }
  ]
}
